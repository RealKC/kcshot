using Gtk 4.0;
using Adw 1;

template $KCShotSettingsWindow: Adw.PreferencesDialog {
    Adw.PreferencesPage {
        icon-name: 'applications-system-symbolic';
        title: _("Overview");

        Adw.PreferencesGroup {
            title: _("General");

            Adw.ActionRow screenshot_directory_row {
                styles [
                    "property",
                ]

                title: _("Screenshot directory");

                activatable-widget: Gtk.Button {};

                activated => $on_screenshot_directory_clicked() swapped;

                Gtk.Image {
                    accessibility {
                        label: "Open folder icon";
                    }

                    icon-name: 'folder-open-symbolic';
                }
            }

            Adw.SwitchRow history_enabled_switch {
                title: _("Enable history");
            }

            Adw.SwitchRow capture_mouse_switch {
                title: _("Capture mouse cursor");
            }

            Adw.SwitchRow editing_starts_by_cropping_switch {
                title: _("Editing starts by cropping");
            }
        }
    }
}
