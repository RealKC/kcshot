using Gtk 4.0;

template $KCShotToolbarWidget: Gtk.Widget {
    $KCShotToolButton group_source {}

    $KCShotToolButton {
        tool: pencil;
        group: group_source;
        spinner: line_width_spinner;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: line;
        group: group_source;
        spinner: line_width_spinner;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: arrow;
        group: group_source;
        spinner: line_width_spinner;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: rectangle;
        group: group_source;
        spinner: line_width_spinner;
        primary: primary;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: highlight;
        group: group_source;
    }

    $KCShotToolButton {
        tool: ellipse;
        group: group_source;
        spinner: line_width_spinner;
        primary: primary;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: pixelate;
        group: group_source;
    }

    $KCShotToolButton {
        tool: blur;
        group: group_source;
    }

    $KCShotToolButton {
        tool: autoincrement-bubble;
        group: group_source;
        primary: primary;
        secondary: secondary;
    }

    $KCShotToolButton {
        tool: text;
        group: group_source;
    }

    $KCShotColourButton primary {
        clicked => $on_primary_colour_clicked() swapped;
        visible: false;
        tooltip-text: "Set primary colour";
    }

    $KCShotColourButton secondary {
        clicked => $on_secondary_colour_clicked() swapped;
        visible: false;
        tooltip-text: "Set secondary colour";
    }

    Gtk.SpinButton line_width_spinner {
        value-changed => $on_line_width_changed() swapped;

        adjustment: Gtk.Adjustment {
            lower: 1.0;
            upper: 1000.0;
            value: 4.0;
            step-increment: 0.4;
            page-increment: 1.0;
            page-size: 1.0;
        };

        climb-rate: 0.5;
        digits: 1;
        numeric: true;
        value: 4.0;
        visible: false;
        tooltip-text: _("Adjust the width of lines");
    }
}
